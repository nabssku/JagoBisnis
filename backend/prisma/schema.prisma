generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  password     String
  avatarUrl    String?
  phone        String?
  role         String         @default("USER")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  BusinessUser BusinessUser[]
  Media        Media[]
}

model Business {
  id           String         @id @default(uuid())
  name         String
  slug         String         @unique
  description  String?
  logoUrl      String?
  category     String?
  phone        String?
  address      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  BusinessUser BusinessUser[]
  Integration  Integration[]
  Media        Media[]
  Order        Order[]
  Post         Post[]
  Product      Product[]
  Site         Site?
  SocialPost   SocialPost[]
  AnalyticsLog AnalyticsLog[]
}

model Site {
  id          String    @id @default(uuid())
  businessId  String    @unique
  title       String
  slug        String    @unique
  theme       Json
  sections    Json
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id])
}

model BusinessUser {
  id         String   @id @default(uuid())
  userId     String
  businessId String
  role       Role     @default(STAFF)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, businessId])
}

model Product {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  slug        String
  description String?
  price       Int
  stock       Int      @default(0)
  imageUrl    String?
  images      String[] @default([])
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Order       Order[]
  business    Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, slug])
}

model Post {
  id                String   @id @default(uuid())
  businessId        String
  title             String
  slug              String
  coverImage        String?
  images            String[] @default([])
  focusKeyword      String?
  metaTitle         String?
  metaDescription   String?
  content           String
  summary           String?
  ctaType           String?  @default("Tanpa Tombol")
  ctaValue          String?
  imageAlt          String?
  contentType       String   @default("Artikel")
  status            String   @default("Draft")
  isPinned          Boolean  @default(false)
  tags              String[] @default([])
  views             Int      @default(0)
  relatedProductIds String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  business          Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, slug])
}

model Integration {
  id                  String              @id @default(uuid())
  businessId          String
  provider            IntegrationProvider
  status              IntegrationStatus   @default(DISCONNECTED)
  accessToken         String?
  refreshToken        String?
  tokenExpiresAt      DateTime?
  providerAccountId   String?
  providerAccountName String?
  config              Json?
  lastSyncedAt        DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  business            Business            @relation(fields: [businessId], references: [id])
  SocialPost          SocialPost[]

  @@unique([businessId, provider])
}

model SocialPost {
  id             String             @id @default(uuid())
  businessId     String
  provider       SocialPostProvider
  integrationId  String
  content        String
  mediaUrls      Json?
  mediaType      MediaType          @default(TEXT)
  status         SocialPostStatus   @default(DRAFT)
  providerPostId String?
  errorMessage   String?
  publishedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  business       Business           @relation(fields: [businessId], references: [id])
  integration    Integration        @relation(fields: [integrationId], references: [id])
}

model Order {
  id                   String        @id @default(uuid())
  businessId           String
  productId            String
  customerName         String
  customerPhone        String
  customerEmail        String?
  customerAddress      String?
  quantity             Int
  productNameSnapshot  String
  productPriceSnapshot Int
  subtotal             Int
  paymentMethod        String
  orderStatus          OrderStatus   @default(PENDING)
  paymentStatus        PaymentStatus @default(UNPAID)
  pakasirOrderId       String?       @unique
  pakasirPaymentUrl    String?
  pakasirPaymentMethod String?
  notes                String?
  metadata             Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  business             Business      @relation(fields: [businessId], references: [id])
  product              Product       @relation(fields: [productId], references: [id])
}

model Media {
  id           String   @id @default(uuid())
  businessId   String
  uploadedById String
  url          String
  filename     String
  name         String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  business     Business @relation(fields: [businessId], references: [id])
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
}

model AnalyticsLog {
  id         String   @id @default(uuid())
  businessId String
  event      String   // e.g. "VIEW_SITE", "VIEW_PRODUCT", "VIEW_BLOG", "CLICK_ORDER"
  path       String
  referrer   String?
  userAgent  String?
  ipHash     String?  // Anonymized unique identifier (SHA-256 of IP + salt)
  metadata   Json?    // Optional extra data (e.g. { productId: "...", blogSlug: "..." })
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, event, createdAt])
}


enum Role {
  OWNER
  ADMIN
  STAFF
}

enum IntegrationProvider {
  INSTAGRAM
  THREADS
  PAKASIR
  GOOGLE_ANALYTICS
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum SocialPostProvider {
  INSTAGRAM
  THREADS
}

enum SocialPostStatus {
  DRAFT
  PUBLISHING
  PUBLISHED
  FAILED
}

enum MediaType {
  TEXT
  IMAGE
  VIDEO
  CAROUSEL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  EXPIRED
  FAILED
}
