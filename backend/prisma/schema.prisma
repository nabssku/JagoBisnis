// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  password     String
  avatarUrl    String?
  phone        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  BusinessUser BusinessUser[]
}

model Business {
  id           String         @id @default(uuid())
  name         String
  slug         String         @unique
  description  String?
  logoUrl      String?
  category     String?
  phone        String?
  address      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  BusinessUser BusinessUser[]
  Product      Product[]
  Site         Site?
  Post         Post[]
  Integration  Integration[]
  SocialPost   SocialPost[]
}

model Site {
  id          String    @id @default(uuid())
  businessId  String    @unique
  title       String
  slug        String    @unique
  theme       Json
  sections    Json
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])
}

model BusinessUser {
  id         String   @id @default(uuid())
  userId     String
  businessId String
  role       Role     @default(STAFF)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@unique([userId, businessId])
}

model Product {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  slug        String
  description String?
  price       Int
  stock       Int      @default(0)
  imageUrl    String?
  images      String[] @default([])
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, slug])
}

model Post {
  id                String   @id @default(uuid())
  businessId        String
  title             String
  slug              String
  coverImage        String?
  images            String[] @default([])
  focusKeyword      String?
  metaTitle         String?
  metaDescription   String?
  content           String
  summary           String?
  ctaType           String?  @default("Tanpa Tombol")
  ctaValue          String?
  imageAlt          String?
  contentType       String   @default("Artikel")
  status            String   @default("Draft")
  isPinned          Boolean  @default(false)
  tags              String[] @default([])
  views             Int      @default(0)
  relatedProductIds String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, slug])
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum IntegrationProvider {
  INSTAGRAM
  THREADS
  PAKASIR
  GOOGLE_ANALYTICS
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model Integration {
  id                  String              @id @default(uuid())
  businessId          String
  provider            IntegrationProvider
  status              IntegrationStatus   @default(DISCONNECTED)
  accessToken         String?             // encrypted
  refreshToken        String?             // encrypted
  tokenExpiresAt      DateTime?
  providerAccountId   String?
  providerAccountName String?
  config              Json?               // e.g. { slug: "...", apiKey: "..." } or { measurementId: "..." }
  lastSyncedAt        DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  business            Business            @relation(fields: [businessId], references: [id])
  SocialPost          SocialPost[]

  @@unique([businessId, provider])
}

enum SocialPostProvider {
  INSTAGRAM
  THREADS
}

enum SocialPostStatus {
  DRAFT
  PUBLISHING
  PUBLISHED
  FAILED
}

enum MediaType {
  TEXT
  IMAGE
  VIDEO
  CAROUSEL
}

model SocialPost {
  id              String             @id @default(uuid())
  businessId      String
  provider        SocialPostProvider
  integrationId   String
  content         String
  mediaUrls       Json?              // e.g. ["url1", "url2"]
  mediaType       MediaType          @default(TEXT)
  status          SocialPostStatus   @default(DRAFT)
  providerPostId  String?
  errorMessage    String?
  publishedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  business        Business           @relation(fields: [businessId], references: [id])
  integration     Integration        @relation(fields: [integrationId], references: [id])
}

