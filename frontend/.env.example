# API URL configuration (Point this to your deployed backend URL, e.g. https://your-backend.vercel.app/api/v1)
# Local development default: http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Site URL configuration (Point this to your deployed frontend URL, e.g. https://your-frontend.vercel.app)
# Local development default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth Configuration (Required for Google Login/Register features)
# Obtain this from Google Cloud Console (Credentials -> OAuth 2.0 Client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
